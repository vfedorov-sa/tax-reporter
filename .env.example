# Каталог с бланками и картами полей
TAX_REPORTER_TEMPLATES_DIR=templates

# Справочник клиник: название из заявки -> реквизиты
TAX_REPORTER_CLINICS_PATH=templates/clinics.json

# Куда складывать готовые справки и пакеты
TAX_REPORTER_OUTPUT_DIR=out

# Файл с росчерком. Не задан — справка соберётся без подписи.
# Демонстрационный можно получить через python scripts/make_signature.py
TAX_REPORTER_SIGNATURE_PATH=

# local — сложить пакет на диск, http — отправить в приёмный узел
TAX_REPORTER_GATEWAY=local
TAX_REPORTER_GATEWAY_URL=
TAX_REPORTER_GATEWAY_TOKEN=

# Источник заявок для /v1/batches/from-intake
TAX_REPORTER_INTAKE_URL=
TAX_REPORTER_INTAKE_TOKEN=

TAX_REPORTER_REQUEST_TIMEOUT=30
TAX_REPORTER_MAX_ATTEMPTS=3
